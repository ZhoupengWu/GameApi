{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "moduleResolution": "nodenext",
        "checkJs": true,
        "allowSyntheticDefaultImports": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "/*": ["./*"]
        }
    },
    "include": [
        "**/*.js"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build"
    ]
}